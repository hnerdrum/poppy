    test/Poppy/Codegen/golden/ShelfReadClient.hs.golden
    test/Poppy/Codegen/golden/Tag.hs.golden
    test/Poppy/Codegen/golden/Widget.hs.golden

source-repository head
  type: git
  location: https://github.com/hnerdrum/poppy

library
  exposed-modules:
      Poppy.Codegen.CLI
      Poppy.Codegen.Drift
      Poppy.Codegen.IR
      Poppy.Codegen.Run
      Poppy.Codegen.Schema
      Poppy.Codegen.Target
      Poppy.Codegen.Validate
  other-modules:
      Poppy.Codegen.Combinator
      Poppy.Codegen.Emit.Client
      Poppy.Codegen.Emit.Combinator
      Poppy.Codegen.Emit.FlatRow
      Poppy.Codegen.Emit.Include
      Poppy.Codegen.Emit.Nest
      Poppy.Codegen.Emit.Schema
      Poppy.Codegen.Emit.SelectIn
      Poppy.Codegen.EmitCommon
      Poppy.Codegen.IncludePath
      Poppy.Codegen.Introspect
      Poppy.Codegen.JoinAlias
      Poppy.Codegen.Lookup
      Poppy.Codegen.TextUtil
  hs-source-dirs:
      src
  default-extensions:
      NamedFieldPuns
      OverloadedRecordDot
      OverloadedStrings
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints
  build-depends:
      base >=4.7 && <5
    , containers
    , directory
    , filepath
    , poppy
    , postgresql-simple
    , text
  default-language: Haskell2010

