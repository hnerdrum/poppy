name:           poppy
version:        0.1.0.0
synopsis:       Prisma-style Schema to Client codegen runtime for Postgres
description:    Runtime library for Poppy. Write a Schema, generate a Client, then query and write through that Client.
category:       Database
homepage:       https://github.com/hnerdrum/poppy#readme
bug-reports:    https://github.com/hnerdrum/poppy/issues
author:         Henrik Nerdrum
maintainer:     henrik.nerdrum@gmail.com
copyright:      2023–2026 Henrik Nerdrum
license:        BSD3
license-file:   LICENSE
build-type:     Simple
extra-source-files:
    test/migrations/001-test-widget.sql
    test/migrations/002-test-shelf-book.sql
    test/migrations/003-test-chapter.sql
    test/migrations/004-test-section.sql
    test/migrations/005-test-tag.sql

source-repository head
  type: git
  location: https://github.com/hnerdrum/poppy

library
  exposed-modules:
      Poppy
      Poppy.Column
      Poppy.Core
      Poppy.Db
      Poppy.Delete
      Poppy.Errors
      Poppy.Group
      Poppy.Include
      Poppy.Insert
      Poppy.JoinChain
      Poppy.Operations
      Poppy.PG
      Poppy.Query
      Poppy.Relation
      Poppy.Select
      Poppy.SelectIn
      Poppy.Sql
      Poppy.Update
      Poppy.Where
  other-modules:
      Paths_poppy
  hs-source-dirs:
      src
  default-extensions:
      DuplicateRecordFields
      NamedFieldPuns
      OverloadedRecordDot
      OverloadedStrings
      TypeFamilies
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints
  build-depends:
      base >=4.7 && <5
    , bytestring
    , containers
    , mtl
    , postgresql-simple
    , resource-pool
    , text
    , time
    , uuid
  default-language: Haskell2010

test-suite poppy-test
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  other-modules:
      Poppy.ErrorsSpec
      Poppy.GroupSpec
      Poppy.IncludeSpec
      Poppy.JoinSpec
      Poppy.NestedWriteSpec
      Poppy.OperationsSpec
      Poppy.RawSpec
      Poppy.SelectSpec
      Poppy.ShelfFixtures
      Poppy.WhereSpec
      Poppy.WidgetFixtures
      Schema.Book
      Schema.BookInclude
      Schema.Chapter
